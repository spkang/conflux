{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Conflux",
  "version": "0.1.0",
  "identifier": "dev.spkang.conflux",
  "build": {
    "beforeDevCommand": "npm --prefix app run dev",
    "beforeBuildCommand": "npm --prefix app run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../app/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Conflux",
        "width": 1440,
        "height": 920,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [],
    "targets": "all",
    "category": "DeveloperTool"
  }
}
